# Copy to .env and fill in. Never commit .env
# The site REFUSES to start without NODE_ENV=production unless you run "npm run dev".
NODE_ENV=production
PORT=3000
SITE_URL=https://yourdomain.com

# Admin panel login: REQUIRED, no default. Use a long passphrase.
ADMIN_PASSWORD=
SESSION_SECRET=

# Razorpay (Dashboard > Settings > API Keys). Start with rzp_test_ keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# ---- Order alerts ----
# Email (Gmail: turn on 2-step verification, then create an "App password" and use it as SMTP_PASS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OWNER_EMAIL=
MAIL_FROM=
# Optional instant phone alert (free): create a bot with @BotFather, message it once, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Storage: MUST be a persistent disk on your host ----
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Debug only: if the Razorpay pop-up misbehaves, set to 1 and read the browser console
# CSP_REPORT_ONLY=1
